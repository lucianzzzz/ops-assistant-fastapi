# 数据源配置
OPS_ASSISTANT_DATA_DIR=/path/to/your/export
OPS_ASSISTANT_KNOWLEDGE_FILE=knowledge.json
OPS_ASSISTANT_METRICS_FILE=metrics.json
OPS_ASSISTANT_PUBLIC_TAGS_FILE=public_tags.json

# AI 助手配置（可选）
# 如果不配置，系统将仅使用本地知识库
# 配置后，当本地知识库匹配度低于 50% 时，会自动使用 AI 增强查询

# OpenAI API Key
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Base URL（可选，默认使用 OpenAI 官方地址）
# 如果使用其他兼容 OpenAI API 的服务（如 Azure OpenAI），可以设置此项
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1

# AI 模型（可选，默认 gpt-4）
# OPENAI_MODEL=gpt-4
# OPENAI_MODEL=gpt-3.5-turbo
